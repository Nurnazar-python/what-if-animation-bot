# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# GitHub
GITHUB_TOKEN=your_github_pat_here
GITHUB_REPO=Nurnazar-python/what-if-animation-bot

# freelm AI providers (at least one required)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
ZAI_API_KEY=
COHERE_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
KILO_API_KEY=

# freelm keyless mode (auto/always/never)
FREELM_KEYLESS=auto

# Database (Railway provides this automatically)
DATABASE_URL=postgresql://user:pass@host:port/db

# Optional: Set to run locally without webhook
# RAILWAY_ENVIRONMENT=production